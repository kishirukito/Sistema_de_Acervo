# ==============================================================================
# SISTEMA DE ACERVO (CIU) - VARIABLES DE ENTORNO
# ==============================================================================

# Entorno general
PROJECT_NAME="Sistema de Acervo (CIU)"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Credenciales de Supabase
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_KEY="tu-anon-key-o-service-role-key"
DATABASE_URL="postgresql://postgres:tu_password@db.tu-proyecto.supabase.co:5432/postgres"

# Seguridad y Autenticación JWT
# Generar una clave segura con: openssl rand -hex 32
SECRET_KEY="clave_super_secreta_jwt_para_firmar_tokens_ciu"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Inteligencia Artificial Local (Ollama / Local LLM)
# Descarga y ejecuta Ollama: https://ollama.ai (ej: ollama run llama3.2:3b)
AI_PROVIDER="local"
OLLAMA_BASE_URL="http://localhost:11434"
LOCAL_AI_MODEL="llama3.2:3b"
LOCAL_EMBEDDING_MODEL="nomic-embed-text"
AI_API_KEY=""
